# VÉRTIGO Cup — Variables de entorno
# Copiar a .env.local y completar con valores reales

# ─── Supabase ───────────────────────────────────────────────
# URL pública del proyecto (https://{ref}.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-ref.supabase.co

# Anon key (pública, va al browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key (SERVER ONLY, nunca exponer al browser)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Password de la DB de Supabase (para exec-sql admin endpoint)
SUPABASE_DB_PASSWORD=tu-db-password

# ─── Database (Drizzle) ─────────────────────────────────────
# Connection string completo para Drizzle ORM
DATABASE_URL=postgresql://postgres.{ref}:{password}@aws-0-{region}.pooler.supabase.com:6543/postgres

# ─── Admin ──────────────────────────────────────────────────
# Token para endpoints admin temporales (exec-sql, upload-handbook, etc.)
# OBLIGATORIO — sin fallback. Generar con: openssl rand -hex 32
ADMIN_EXEC_TOKEN=generar-token-aleatorio-de-64-chars

# ─── AoE2 Companion API ────────────────────────────────────
# URL base del proxy a AoE2 Companion (opcional, tiene default)
AOE2_COMPANION_API_URL=https://data.aoe2companion.com/api

# User-Agent header para AoE2 Companion (opcional, tiene default)
AOE2_COMPANION_USER_AGENT=VERTIGO-Cup/1.0

# ─── App ───────────────────────────────────────────────────
# URL pública del sitio (para absolute URLs en emails, og:image, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

